{
  "name": "algorave-kit",
  "displayName": "Algorave Kit: Strudel + Tidal live coding",
  "description": "Live code Strudel and TidalCycles from VS Code: eval with Ctrl+Enter, live pattern highlighting, pianoroll and Hydra visuals, a projector view and your kit's patterns in the sidebar.",
  "version": "0.5.0",
  "publisher": "samburwood23",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samburwood23/live_coding",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "strudel",
    "tidalcycles",
    "tidal",
    "live coding",
    "algorave",
    "hydra",
    "music"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:strudel",
    "onLanguage:tidal",
    "workspaceContains:**/patterns.js",
    "workspaceContains:**/*.tidal"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Booting Tidal and reading your kit's patterns.js run code from the workspace, so they only work in trusted workspaces. Strudel playback works everywhere."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "strudel",
        "aliases": [
          "Strudel",
          "strudel"
        ],
        "extensions": [
          ".strudel",
          ".str"
        ],
        "configuration": "./language/strudel-language-configuration.json"
      },
      {
        "id": "tidal",
        "aliases": [
          "TidalCycles",
          "tidal"
        ],
        "extensions": [
          ".tidal"
        ],
        "configuration": "./language/tidal-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "strudel",
        "scopeName": "source.strudel",
        "path": "./language/strudel.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript"
        }
      },
      {
        "language": "tidal",
        "scopeName": "source.tidal",
        "path": "./language/tidal.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "algorave.eval",
        "title": "Evaluate (play / update)",
        "category": "Algorave",
        "icon": "$(play)"
      },
      {
        "command": "algorave.evalLine",
        "title": "Evaluate Line",
        "category": "Algorave"
      },
      {
        "command": "algorave.hush",
        "title": "Hush (stop everything)",
        "category": "Algorave",
        "icon": "$(debug-stop)"
      },
      {
        "command": "algorave.showVisuals",
        "title": "Show Strudel Engine / Visuals",
        "category": "Algorave",
        "icon": "$(eye)"
      },
      {
        "command": "algorave.toggleProjector",
        "title": "Toggle Projector View (code over visuals)",
        "category": "Algorave",
        "icon": "$(screen-full)"
      },
      {
        "command": "algorave.visualsToNewWindow",
        "title": "Put Visuals on the Projector Screen",
        "category": "Algorave"
      },
      {
        "command": "algorave.togglePerformanceMode",
        "title": "Toggle Performance Mode",
        "category": "Algorave",
        "icon": "$(flame)"
      },
      {
        "command": "algorave.tidal.boot",
        "title": "Boot Tidal",
        "category": "Algorave"
      },
      {
        "command": "algorave.tidal.quit",
        "title": "Quit Tidal",
        "category": "Algorave"
      },
      {
        "command": "algorave.tidal.startSuperDirt",
        "title": "Start SuperDirt (sclang)",
        "category": "Algorave"
      },
      {
        "command": "algorave.patterns.refresh",
        "title": "Refresh Patterns",
        "category": "Algorave",
        "icon": "$(refresh)"
      },
      {
        "command": "algorave.patterns.open",
        "title": "Open Pattern",
        "category": "Algorave",
        "icon": "$(go-to-file)"
      },
      {
        "command": "algorave.patterns.play",
        "title": "Play Pattern",
        "category": "Algorave",
        "icon": "$(play)"
      },
      {
        "command": "algorave.patterns.pick",
        "title": "Open Pattern from Kit…",
        "category": "Algorave"
      },
      {
        "command": "algorave.newStrudelFile",
        "title": "New Strudel Sketch",
        "category": "Algorave",
        "icon": "$(new-file)"
      },
      {
        "command": "algorave.diagnose",
        "title": "Test Sound & Graphics in VS Code",
        "category": "Algorave"
      },
      {
        "command": "algorave.evalQueued",
        "title": "Evaluate on the Next Phrase",
        "category": "Algorave",
        "icon": "$(clock)"
      },
      {
        "command": "algorave.cancelQueued",
        "title": "Cancel Queued Swap",
        "category": "Algorave"
      },
      {
        "command": "algorave.patterns.queue",
        "title": "Queue Pattern (starts on the next phrase)",
        "category": "Algorave",
        "icon": "$(clock)"
      },
      {
        "command": "algorave.drop",
        "title": "Drop (build, snare roll, drop on the line)",
        "category": "Algorave",
        "icon": "$(arrow-down)"
      },
      {
        "command": "algorave.mute",
        "title": "Mute / Unmute Layers…",
        "category": "Algorave",
        "icon": "$(mute)"
      },
      {
        "command": "algorave.solo",
        "title": "Solo a Layer…",
        "category": "Algorave"
      },
      {
        "command": "algorave.unmuteAll",
        "title": "Unmute All Layers",
        "category": "Algorave"
      },
      {
        "command": "algorave.mutate",
        "title": "Mutate the Layer Under the Cursor",
        "category": "Algorave",
        "icon": "$(sparkle)"
      },
      {
        "command": "algorave.setlist.next",
        "title": "Set List: Next (queued)",
        "category": "Algorave",
        "icon": "$(arrow-right)"
      },
      {
        "command": "algorave.setlist.previous",
        "title": "Set List: Previous (queued)",
        "category": "Algorave",
        "icon": "$(arrow-left)"
      },
      {
        "command": "algorave.setlist.go",
        "title": "Set List: Open Item",
        "category": "Algorave"
      },
      {
        "command": "algorave.setlist.play",
        "title": "Set List: Queue This",
        "category": "Algorave",
        "icon": "$(clock)"
      },
      {
        "command": "algorave.setlist.add",
        "title": "Add to Set List",
        "category": "Algorave",
        "icon": "$(add)"
      },
      {
        "command": "algorave.setlist.remove",
        "title": "Remove from Set List",
        "category": "Algorave",
        "icon": "$(trash)"
      },
      {
        "command": "algorave.setlist.moveUp",
        "title": "Move Up",
        "category": "Algorave",
        "icon": "$(arrow-up)"
      },
      {
        "command": "algorave.setlist.moveDown",
        "title": "Move Down",
        "category": "Algorave",
        "icon": "$(arrow-down)"
      },
      {
        "command": "algorave.setlist.editNote",
        "title": "Edit Note",
        "category": "Algorave",
        "icon": "$(note)"
      },
      {
        "command": "algorave.setlist.openFile",
        "title": "Open setlist.json",
        "category": "Algorave",
        "icon": "$(json)"
      },
      {
        "command": "algorave.toggleLayer1",
        "title": "Mute / Unmute Layer 1",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer2",
        "title": "Mute / Unmute Layer 2",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer3",
        "title": "Mute / Unmute Layer 3",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer4",
        "title": "Mute / Unmute Layer 4",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer5",
        "title": "Mute / Unmute Layer 5",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer6",
        "title": "Mute / Unmute Layer 6",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer7",
        "title": "Mute / Unmute Layer 7",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer8",
        "title": "Mute / Unmute Layer 8",
        "category": "Algorave"
      },
      {
        "command": "algorave.toggleLayer9",
        "title": "Mute / Unmute Layer 9",
        "category": "Algorave"
      },
      {
        "command": "algorave.offline.prefetch",
        "title": "Download Kit for Offline",
        "category": "Algorave",
        "icon": "$(cloud-download)"
      },
      {
        "command": "algorave.offline.status",
        "title": "Offline Cache Status",
        "category": "Algorave"
      },
      {
        "command": "algorave.offline.clear",
        "title": "Clear Offline Cache",
        "category": "Algorave"
      },
      {
        "command": "algorave.agent.connectClaudeCode",
        "title": "Connect Claude Code (MCP)",
        "category": "Algorave"
      },
      {
        "command": "algorave.agent.newToken",
        "title": "Make a New MCP Token",
        "category": "Algorave"
      },
      {
        "command": "algorave.claude.ask",
        "title": "Ask Claude to Change the Music…",
        "category": "Algorave",
        "icon": "$(sparkle)"
      },
      {
        "command": "algorave.claude.jam",
        "title": "Jam with Claude (start / stop)",
        "category": "Algorave",
        "icon": "$(sparkle)"
      },
      {
        "command": "algorave.claude.cancel",
        "title": "Cancel Claude",
        "category": "Algorave"
      },
      {
        "command": "algorave.claude.resetChat",
        "title": "Claude: Start a Fresh Conversation",
        "category": "Algorave"
      },
      {
        "command": "algorave.claude.setKey",
        "title": "Set Claude API Key",
        "category": "Algorave"
      }
    ],
    "keybindings": [
      {
        "command": "algorave.eval",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.evalLine",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == tidal"
      },
      {
        "command": "algorave.eval",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == strudel"
      },
      {
        "command": "algorave.hush",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.hush",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "algorave.togglePerformanceMode",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "algorave.toggleProjector",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v"
      },
      {
        "command": "algorave.evalQueued",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.cancelQueued",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "algorave.drop",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "algorave.mute",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.solo",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.unmuteAll",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.mutate",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && editorLangId == strudel"
      },
      {
        "command": "algorave.setlist.next",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "algorave.setlist.previous",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "algorave.toggleLayer1",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer2",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer3",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer4",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer5",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer6",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer7",
        "key": "ctrl+alt+7",
        "mac": "cmd+alt+7",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer8",
        "key": "ctrl+alt+8",
        "mac": "cmd+alt+8",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.toggleLayer9",
        "key": "ctrl+alt+9",
        "mac": "cmd+alt+9",
        "when": "editorTextFocus && editorLangId =~ /^(strudel|tidal)$/"
      },
      {
        "command": "algorave.claude.ask",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "algorave.claude.jam",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "algorave.eval",
          "when": "editorLangId =~ /^(strudel|tidal)$/",
          "group": "navigation@1"
        },
        {
          "command": "algorave.evalQueued",
          "when": "editorLangId == strudel",
          "group": "navigation@1"
        },
        {
          "command": "algorave.claude.ask",
          "when": "editorLangId == strudel",
          "group": "navigation@2"
        },
        {
          "command": "algorave.hush",
          "when": "editorLangId =~ /^(strudel|tidal)$/",
          "group": "navigation@2"
        },
        {
          "command": "algorave.showVisuals",
          "when": "editorLangId == strudel",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "algorave.offline.prefetch",
          "when": "view == algorave.patterns",
          "group": "navigation@0"
        },
        {
          "command": "algorave.newStrudelFile",
          "when": "view == algorave.patterns",
          "group": "navigation@1"
        },
        {
          "command": "algorave.togglePerformanceMode",
          "when": "view == algorave.patterns",
          "group": "navigation@2"
        },
        {
          "command": "algorave.patterns.refresh",
          "when": "view == algorave.patterns",
          "group": "navigation@3"
        },
        {
          "command": "algorave.setlist.previous",
          "when": "view == algorave.setlist",
          "group": "navigation@1"
        },
        {
          "command": "algorave.setlist.next",
          "when": "view == algorave.setlist",
          "group": "navigation@2"
        },
        {
          "command": "algorave.setlist.add",
          "when": "view == algorave.setlist",
          "group": "navigation@3"
        },
        {
          "command": "algorave.setlist.openFile",
          "when": "view == algorave.setlist",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "algorave.patterns.play",
          "when": "view == algorave.patterns && viewItem =~ /playable/",
          "group": "inline@1"
        },
        {
          "command": "algorave.patterns.queue",
          "when": "view == algorave.patterns && viewItem =~ /playable/",
          "group": "inline@2"
        },
        {
          "command": "algorave.patterns.open",
          "when": "view == algorave.patterns && viewItem =~ /pattern/",
          "group": "inline@3"
        },
        {
          "command": "algorave.setlist.add",
          "when": "view == algorave.patterns && viewItem =~ /strudel/",
          "group": "setlist@1"
        },
        {
          "command": "algorave.setlist.play",
          "when": "view == algorave.setlist && viewItem == setItem",
          "group": "inline@1"
        },
        {
          "command": "algorave.setlist.editNote",
          "when": "view == algorave.setlist && viewItem == setItem",
          "group": "inline@2"
        },
        {
          "command": "algorave.setlist.moveUp",
          "when": "view == algorave.setlist && viewItem == setItem",
          "group": "inline@3"
        },
        {
          "command": "algorave.setlist.moveDown",
          "when": "view == algorave.setlist && viewItem == setItem",
          "group": "inline@4"
        },
        {
          "command": "algorave.setlist.remove",
          "when": "view == algorave.setlist && viewItem == setItem",
          "group": "zremove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "algorave.patterns.open",
          "when": "false"
        },
        {
          "command": "algorave.patterns.play",
          "when": "false"
        },
        {
          "command": "algorave.setlist.go",
          "when": "false"
        },
        {
          "command": "algorave.setlist.play",
          "when": "false"
        },
        {
          "command": "algorave.setlist.remove",
          "when": "false"
        },
        {
          "command": "algorave.setlist.moveUp",
          "when": "false"
        },
        {
          "command": "algorave.setlist.moveDown",
          "when": "false"
        },
        {
          "command": "algorave.setlist.editNote",
          "when": "false"
        },
        {
          "command": "algorave.patterns.queue",
          "when": "false"
        }
      ],
      "editor/title/context": [
        {
          "command": "algorave.setlist.add",
          "when": "resourceExtname =~ /^\\.(strudel|str|tidal)$/"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "algorave",
          "title": "Algorave Kit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "algorave": [
        {
          "id": "algorave.patterns",
          "name": "Patterns"
        },
        {
          "id": "algorave.setlist",
          "name": "Set List"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "algorave.patterns",
        "contents": "No kit found in this workspace. Open your live_coding repo, or point the setting at it.\n[Set kit folder](command:workbench.action.openSettings?%22algorave.kitPath%22)\n[New Strudel sketch](command:algorave.newStrudelFile)"
      },
      {
        "view": "algorave.setlist",
        "contents": "Your running order, with notes only you see. Right-click a pattern → Add to Set List, or add the file you're editing.\n[Add current file](command:algorave.setlist.add)\nCtrl+Alt+N queues the next item on the next phrase."
      }
    ],
    "configuration": {
      "title": "Algorave Kit",
      "properties": {
        "algorave.kitPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder of your live coding kit (the one with `patterns.js` and `tidal/`). Leave empty to find it in the open workspace."
        },
        "algorave.strudel.engine": {
          "type": "string",
          "enum": [
            "panel",
            "browser"
          ],
          "default": "panel",
          "enumDescriptions": [
            "Play inside VS Code, in a panel beside the code",
            "Play in a tab of your web browser that VS Code drives (use this if the panel has no sound or graphics, e.g. on the Snap build of VS Code)"
          ],
          "markdownDescription": "Where the Strudel engine runs. `panel` plays inside VS Code. `browser` opens a tab in your default browser that VS Code drives. Run **Algorave: Test Sound & Graphics in VS Code** to check the panel works on your machine."
        },
        "algorave.strudel.replUrl": {
          "type": "string",
          "default": "https://unpkg.com/@strudel/repl@1.3.0",
          "markdownDescription": "Where the visuals panel loads the Strudel engine from. Pin a version so a gig never surprises you."
        },
        "algorave.strudel.highlight": {
          "type": "boolean",
          "default": true,
          "description": "Outline the mini-notation steps in your editor as they play."
        },
        "algorave.strudel.openPatternIn": {
          "type": "string",
          "enum": [
            "newTab",
            "activeEditor"
          ],
          "default": "newTab",
          "enumDescriptions": [
            "Open each kit pattern in a new untitled Strudel tab",
            "Replace the text of the active Strudel editor"
          ],
          "description": "Where kit patterns open."
        },
        "algorave.flash": {
          "type": "boolean",
          "default": true,
          "description": "Flash the code you just evaluated."
        },
        "algorave.tidal.ghciPath": {
          "type": "string",
          "default": "ghci",
          "markdownDescription": "Command used to start GHCi. Use e.g. `stack` with `algorave.tidal.ghciArgs` set to `[\"exec\", \"--package\", \"tidal\", \"--\", \"ghci\"]` if Tidal lives in a Stack project."
        },
        "algorave.tidal.ghciArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed before the boot script."
        },
        "algorave.tidal.bootFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `BootTidal.hs`. Empty = your kit's `tidal/BootTidal.hs`, falling back to the one bundled with the extension."
        },
        "algorave.tidal.startSuperDirt": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also launch `sclang` with your kit's `tidal/superdirt_startup.scd` when Tidal boots. Leave off if you start SuperDirt from the SuperCollider IDE."
        },
        "algorave.tidal.sclangPath": {
          "type": "string",
          "default": "sclang",
          "description": "Command used to start SuperCollider's sclang."
        },
        "algorave.tidal.superDirtStartupFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "SuperDirt startup file. Empty = your kit's `tidal/superdirt_startup.scd`."
        },
        "algorave.tidal.showOutputOnError": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the Tidal output when GHCi reports an error (it never steals focus from the editor)."
        },
        "algorave.performance.fontSize": {
          "type": "number",
          "default": 22,
          "description": "Editor font size for Strudel and Tidal files in performance mode."
        },
        "algorave.performance.zenMode": {
          "type": "boolean",
          "default": true,
          "description": "Enter Zen Mode in performance mode."
        },
        "algorave.performance.showVisuals": {
          "type": "boolean",
          "default": true,
          "description": "Open the visuals panel beside the code in performance mode."
        },
        "algorave.performance.projector": {
          "type": "boolean",
          "default": false,
          "description": "Start the visuals panel in projector view (code over visuals) in performance mode."
        },
        "algorave.launch.quantize": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "4",
            "8",
            "16"
          ],
          "default": "4",
          "markdownDescription": "Queued swaps (`Ctrl+Shift+Enter`, the ⏱ button on a pattern, Set List: Next) start on the next multiple of this many bars."
        },
        "algorave.drop.buildBars": {
          "type": "string",
          "enum": [
            "2",
            "4"
          ],
          "default": "4",
          "description": "How many bars the drop's build (filter sweep + snare roll) lasts."
        },
        "algorave.drop.landEvery": {
          "type": "string",
          "enum": [
            "4",
            "8",
            "16"
          ],
          "default": "8",
          "description": "The drop lands on the next multiple of this many bars (after a full build)."
        },
        "algorave.offline.cache": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep a copy of everything Strudel downloads (the engine, sample maps, samples, soundfonts, Hydra) so sets play with no internet. Run **Algorave: Download Kit for Offline** before a gig to fetch every sound your kit uses."
        },
        "algorave.agent.mcp": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Serve the extension's controls as an MCP server on `http://127.0.0.1:<port>/mcp` (token-protected), for Claude Code and VS Code's agent mode. See **Algorave: Connect Claude Code**."
        },
        "algorave.agent.port": {
          "type": "number",
          "default": 47130,
          "description": "Port for the local server (MCP, offline cache, browser engine). If it's taken, a free one is used."
        },
        "algorave.claude.model": {
          "type": "string",
          "enum": [
            "claude-sonnet-5-5",
            "claude-opus-5-5",
            "claude-haiku-5-5"
          ],
          "default": "claude-sonnet-5-5",
          "enumDescriptions": [
            "Good balance of musical judgement and speed",
            "Best judgement, slower",
            "Fastest, for quick changes"
          ],
          "description": "Model for the Claude co-performer (Ask and Jam)."
        },
        "algorave.claude.jamEveryBars": {
          "type": "number",
          "default": 16,
          "description": "In Jam mode, Claude makes one change every this many bars (it lands on that bar line)."
        },
        "algorave.claude.jamMaxChanges": {
          "type": "number",
          "default": 24,
          "description": "Jam mode stops by itself after this many changes, to keep API costs in check."
        },
        "algorave.claude.apiBase": {
          "type": "string",
          "default": "https://api.anthropic.com",
          "description": "Anthropic API address (change only for a proxy)."
        }
      }
    },
    "colors": [
      {
        "id": "algorave.activeStep",
        "description": "Outline of mini-notation steps that are playing.",
        "defaults": {
          "dark": "#ffcc00",
          "light": "#c06000",
          "highContrast": "#ffff00"
        }
      },
      {
        "id": "algorave.flashBackground",
        "description": "Flash behind code you just evaluated.",
        "defaults": {
          "dark": "#ffcc0040",
          "light": "#ffaa0040",
          "highContrast": "#ffff0060"
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "algorave.mcp",
        "label": "Algorave Kit"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "acorn": "^8.19.0"
  }
}
